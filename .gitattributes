# Normalize line endings so checkouts are consistent across machines.
* text=auto

# Windows-centric tooling: keep CRLF in the working tree for these.
*.ps1   text eol=crlf
*.cs    text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.vcxproj text eol=crlf
*.vsct  text eol=crlf
*.vstemplate text eol=crlf
*.vsixmanifest text eol=crlf

# Binary assets — never touch.
*.dll   binary
*.exe   binary
*.tga   binary
*.rdf   binary
*.abc   binary
*.png   binary
