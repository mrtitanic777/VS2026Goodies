<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Xbox 360 AD7 debug engine — maps VS's debugger (AD7 COM interfaces) onto the
       managed XBDM session. AnyCPU, net472 (VS's debugger host). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Xbox360.DebugEngine</AssemblyName>
    <RootNamespace>Xbox360.DebugEngine</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Interop.10.0" Version="17.0.32112.339" />
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Interop.11.0" Version="17.0.32112.339" />
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Interop.12.0" Version="17.0.32112.339" />
    <PackageReference Include="Microsoft.VisualStudio.OLE.Interop" Version="17.0.32112.339" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Interop" Version="17.0.32112.339" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xbox360.Xbdm\Xbox360.Xbdm.csproj" />
  </ItemGroup>
</Project>
